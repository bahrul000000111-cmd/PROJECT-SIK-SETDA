							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/transactions?page=1&per_page=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"transactions"
							],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Nomor halaman (default: 1)"
								},
								{
									"key": "per_page",
									"value": "10",
									"description": "Jumlah per halaman (default: 10, -1 untuk semua)"
								},
								{
									"key": "start_date",
									"value": "2026-01-01",
									"description": "Tanggal mulai filter (format: YYYY-MM-DD)",
									"disabled": true
								},
								{
									"key": "end_date",
									"value": "2026-12-31",
									"description": "Tanggal akhir filter (format: YYYY-MM-DD)",
									"disabled": true
								},
								{
									"key": "jenis_spm",
									"value": "GU",
									"description": "Filter jenis SPM: GU / TU / TU Nihil / LS",
									"disabled": true
								},
								{
									"key": "bagian",
									"value": "",
									"description": "Filter nama bagian (partial match)",
									"disabled": true
								}
							]
						},
						"description": "Mengambil riwayat transaksi belanja dengan dukungan filter tanggal (start_date / end_date) dan pagination 10 per halaman (sesuai rubrik)."
					},
					"response": []
				},
				{
					"name": "POST Create Transaction (with DPA Validation)",
					"id": "50948386-d1a24cbc-2aee-4b51-9879-49bc86e69290",
					"protocolProfileBehavior": {
						"disableBodyPruning": true
					},
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nomor_spm\": \"SPM-2026-001\",\n  \"tanggal_spm\": \"2026-05-20\",\n  \"jenis_spm\": \"GU\",\n  \"bagian\": \"Bagian Umum\",\n  \"kode_sub_kegiatan\": \"1.01.03.2.01\",\n  \"uraian_belanja\": \"Belanja ATK Kantor\",\n  \"sumber_dana\": \"DAU\",\n  \"nominal\": 4500000,\n  \"pajak\": {\n    \"tanggal_pajak\": \"2026-05-20\",\n    \"jenis_pajak\": \"PPN\",\n    \"ntpn\": \"ABC1234567890\",\n    \"nominal_pajak\": 450000\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/transactions",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"transactions"
							]
						},
						"description": "Menyimpan transaksi belanja baru.\n\nANTI-JEBOL VALIDATION:\nJika kode_sub_kegiatan diisi, sistem akan memeriksa sisa anggaran DPA.\nJika nominal > sisa anggaran, akan dikembalikan response 422:\n{\n  \"message\": \"Validasi Gagal: Nominal melebihi Sisa Anggaran DPA!\",\n  \"errors\": { \"nominal\": [\"Sisa anggaran saat ini hanya Rp X\"] }\n}\n\nField 'pajak' bersifat opsional — hanya isi jika ada transaksi pajak."
					},
					"response": []
				},
