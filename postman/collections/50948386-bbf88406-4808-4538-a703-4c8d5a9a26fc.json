		{
			"name": "4. Transactions (Riwayat Transaksi)",
			"item": [
				{
					"name": "GET Transactions (with Filter & Pagination)",
					"id": "50948386-7e544f03-7c5c-4379-9916-81dcb569a4eb",
					"protocolProfileBehavior": {
						"disableBodyPruning": true
					},
					"request": {
